// Panes marked start_suspended=true no arrancan su comando hasta pulsar Enter
// dentro del pane. Evita errores de conexion al abrir proyectos que no tienen
// redis / base de datos / cluster (p.ej. librerias frontend), o cuyos
// contenedores todavia no estan levantados.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
    }

    tab name="work" focus=true {
        pane split_direction="vertical" {
            pane size="50%" name="nvim" focus=true command="fish" {
                args "-c" "nvim; exec fish"
            }
            pane size="50%" name="claude" command="fish" {
                args "-c" "claude --continue; or claude; exec fish"
            }
        }
    }
    tab name="term" {
        pane name="terminal"
    }
    tab name="git" {
        pane name="lazygit" command="lazygit"
    }
{{- if .install_docker }}
    tab name="docker" {
        pane name="lazydocker" command="lazydocker"
    }
{{- end }}
    tab name="redis" {
        pane name="iredis" command="iredis" start_suspended=true {
            args "-h" "127.0.0.1" "-p" "6379"
        }
    }
    tab name="sql" {
        pane name="lazysql" command="lazysql" start_suspended=true
    }
    tab name="k9s" {
        pane name="k9s" command="k9s" start_suspended=true
    }
}
